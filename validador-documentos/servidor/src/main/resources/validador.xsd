<?xml version="1.0" encoding="UTF-8"?> <!--declaracao d XML -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"                 
           xmlns:tns="http://ifsp.edu.br/validador"                     
           targetNamespace="http://ifsp.edu.br/validador"               
           elementFormDefault="qualified"> <!-- filhos com namespace -->
    <!--Requisição-->
    <xs:element name="ValidarDocumentoRequest">
        <xs:complexType>
            <xs:sequence><!--ordem fixa-->
                <xs:element name="tipo_doc" type="xs:int"/> 
                <xs:element name="doc" type="xs:string"/>  
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <!-- Resposta -->
    <xs:element name="ValidarDocumentoResponse">
        <xs:complexType>
            <xs:sequence>
                    <xs:element name="valido" type="xs:int"/>
                    <xs:element name="erro" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>